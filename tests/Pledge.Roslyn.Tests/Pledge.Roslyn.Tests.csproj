<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      The harnesses compile snippets against the running runtime's assemblies, run the generated code, and drive the
      analyzers and code fixes through CompilationWithAnalyzers and an AdhocWorkspace. No reference-assembly
      downloads, so the tests behave the same offline and in CI.
    -->
    <ProjectReference Include="../../src/Pledge/Pledge.csproj" />
    <ProjectReference Include="../../src/Pledge.Roslyn/Pledge.Roslyn.csproj" />
    <ProjectReference Include="../../src/Pledge.Roslyn.CodeFixes/Pledge.Roslyn.CodeFixes.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

</Project>
