<Project Sdk="Microsoft.NET.Sdk">

  <!-- The domain under test is contracted, so this project is wired like a package consumer: props before, targets after. -->
  <Import Project="../../src/Pledge/build/Pledge.props" />

  <PropertyGroup>
    <!-- Explicit, because CI builds Release, where the default is Ignore and no probes would be registered. -->
    <PledgeMode>Enforce</PledgeMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Pledge/Pledge.csproj" />
    <ProjectReference Include="../../src/Pledge.Roslyn/Pledge.Roslyn.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Pledge.Testing/Pledge.Testing.csproj" />
    <ProjectReference Include="../../src/Pledge.Testing.Xunit/Pledge.Testing.Xunit.csproj" />
  </ItemGroup>

  <Import Project="../../src/Pledge/build/Pledge.targets" />

</Project>
