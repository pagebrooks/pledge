<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds throwaway consumer projects with the real SDK and checks what comes out: mode properties and their
    validation, each mode's behaviour at run time, Ignore mode's byte-identical assemblies, and the packed package.
    Most fixtures load Pledge, Pledge.Attributes and the Pledge.Roslyn analyzer from copies of this project's output
    and import Pledge.targets from the source tree, so they see exactly what this commit would ship; the package
    tests pack the src projects and consume them through a PackageReference.
  -->

  <ItemGroup>
    <ProjectReference Include="../../src/Pledge/Pledge.csproj" />
    <!-- For its output only: the fixtures load Pledge.Roslyn.dll as an analyzer from this project's bin folder. -->
    <ProjectReference Include="../../src/Pledge.Roslyn/Pledge.Roslyn.csproj" />
    <PackageReference Include="ICSharpCode.Decompiler" />
  </ItemGroup>

  <ItemGroup>
    <!-- PackageConsumerTests packs the src projects without building them, so it needs the configuration they were built in. -->
    <AssemblyMetadata Include="Configuration" Value="$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixture sources are compiled by the fixture projects, never by this one. -->
    <Compile Remove="Fixtures/**" />
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
