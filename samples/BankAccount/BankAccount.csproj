<Project Sdk="Microsoft.NET.Sdk">

  <!-- The same props the NuGet package imports, so this sample builds the way a consumer's project would. -->
  <Import Project="../../src/Pledge/build/Pledge.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The sample doubles as the Native AOT canary: CI publishes it per RID, and TreatWarningsAsErrors makes any trim or AOT warning fatal. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Pledge/Pledge.csproj" />
    <ProjectReference Include="../../src/Pledge.Roslyn/Pledge.Roslyn.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
