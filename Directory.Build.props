<Project>

  <PropertyGroup Label="Build">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <!-- Explicit so nested Directory.Build.props files (src/, tests/) do not each get their own artifacts/ folder. -->
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <!--
      Namespaces are rooted at PledgeContracts, never at Pledge. C# resolves a simple name against namespace
      members before using directives, so a root namespace named Pledge anywhere in a compilation would make
      `Pledge.Requires(...)` bind to the namespace and fail (CS0234). Package and assembly names keep the Pledge
      prefix; only the namespace moves. Pledge.Attributes overrides this to put its types in PledgeContracts itself.
    -->
    <RootNamespace Condition="$(MSBuildProjectName.StartsWith('Pledge'))">$(MSBuildProjectName.Replace('Pledge', 'PledgeContracts'))</RootNamespace>
    <!-- Trim and AOT warnings are listed one per site, not collapsed to one per assembly. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Required in every project for IDE0005 (unnecessary usings) to run at build time: https://github.com/dotnet/roslyn/issues/41640 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (public member without XML doc): docs are written deliberately, not demanded by the build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <!-- Only projects under src/ opt back in; see src/Directory.Build.props. -->
    <IsPackable>false</IsPackable>
    <!-- Versions come from git tags via MinVer (see RELEASING.md): a vX.Y.Z tag is a release, anything else is the next patch as -alpha.0.N. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <Authors>Page Brooks</Authors>
    <Product>Pledge</Product>
    <Copyright>Copyright (c) 2026 Page Brooks</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pagebrooks/pledge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pagebrooks/pledge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>design-by-contract;contracts;preconditions;postconditions;invariants;roslyn;source-generator;interceptors</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Label="Signing">
    <!--
      Strong naming gives assemblies an identity for binding and InternalsVisibleTo, not trust, so the key is
      checked in and anyone can build a binary-compatible Pledge. Trust comes from NuGet package signing in
      the release pipeline (see RELEASING.md). Public key token: 64d74533f2bd81a4.
    -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Pledge.snk</AssemblyOriginatorKeyFile>
    <PledgePublicKey></PledgePublicKey>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <!-- A strong-named assembly can only grant internals access to strong-named friends, so every InternalsVisibleTo carries the key. -->
    <InternalsVisibleTo Key="$(PledgePublicKey)" />
  </ItemDefinitionGroup>

</Project>
