<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Roslyn">
    <!--
      Pinned to the compiler that ships with the oldest supported SDK (10.0.100), so the generator
      and analyzers load in every SDK the design targets. Bump deliberately, not via Dependabot.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup Label="Testing bridge">
    <PackageVersion Include="CsCheck" Version="5.0.0" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="TUnit.Core" Version="1.76.45" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- The TUnit adapter's tests run under TUnit itself; kept on the same version as TUnit.Core above. -->
    <PackageVersion Include="TUnit" Version="1.76.45" />
    <!-- ILSpy's engine: disassembles fixture assemblies so a failed IL comparison shows the differing methods. -->
    <PackageVersion Include="ICSharpCode.Decompiler" Version="11.2.0.10050" />
  </ItemGroup>

</Project>
