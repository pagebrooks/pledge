<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!--
      Ships inside the Pledge.Analyzers package (see src/Pledge.Analyzers/Pledge.Analyzers.csproj); never packed on its own.
      Code fixes live in their own assembly because they need Microsoft.CodeAnalysis.Workspaces, which the
      command-line compiler does not load. They do not reference the analyzer assembly; diagnostic ids are shared as source.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pledge.Analyzers.Tests" />
  </ItemGroup>

</Project>
