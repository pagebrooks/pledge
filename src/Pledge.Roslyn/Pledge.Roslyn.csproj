<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!--
      The compiler side of Pledge. The incremental generator and the DBC analyzers share this assembly
      because they share the code that reads contracts out of method bodies. Ships inside the Pledge
      package under analyzers/dotnet/cs (see src/Pledge/Pledge.csproj); never packed on its own.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pledge.Roslyn.Tests" />
  </ItemGroup>

</Project>
