<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!--
      Code fixes need Microsoft.CodeAnalysis.Workspaces, which the command-line compiler does not load,
      so they live apart from Pledge.Roslyn and share diagnostic ids with it as linked source, not by
      assembly reference. Ships inside the Pledge package next to Pledge.Roslyn; never packed on its own.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with Pledge.Roslyn as source: the ids the fixes answer to and the syntax test for a contract statement. -->
    <Compile Include="../Pledge.Roslyn/DiagnosticIds.cs" Link="Shared/DiagnosticIds.cs" />
    <Compile Include="../Pledge.Roslyn/Generator/ContractSyntax.cs" Link="Shared/ContractSyntax.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pledge.Roslyn.Tests" />
  </ItemGroup>

</Project>
