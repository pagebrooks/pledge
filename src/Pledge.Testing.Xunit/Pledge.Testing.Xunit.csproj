<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 rather than the runtime's net8.0: CsCheck 5.x targets net10.0+, and this package only runs inside test projects. -->
    <TargetFramework>net10.0</TargetFramework>
    <Description>xUnit.net v3 adapter for Pledge.Testing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Pledge.Testing/Pledge.Testing.csproj" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pledge.Testing.Tests" />
  </ItemGroup>

</Project>
