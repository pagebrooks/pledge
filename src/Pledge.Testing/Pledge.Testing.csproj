<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 rather than the runtime's net8.0: CsCheck 5.x targets net10.0+, and this package only runs inside test projects. -->
    <TargetFramework>net10.0</TargetFramework>
    <Description>Turns Pledge contracts into property-based tests: preconditions filter generated inputs, postconditions are the oracle. CsCheck backend.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Pledge/Pledge.csproj" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pledge.Testing.Tests" />
  </ItemGroup>

</Project>
