<Project>

  <!--
    NuGet imports this into every project that references the Pledge package, before the project file.
    It registers the namespace the generator emits interceptors into, so the compiler accepts them
    (SDK 10+, C# 14+). This is the one setup step the package exists to remove; analyzer PLEDGE005
    reports the cases where this import did not take effect. Pledge.targets, imported after the
    project file, picks the enforcement mode.
  -->
  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);PledgeContracts.Generated</InterceptorsNamespaces>
  </PropertyGroup>

</Project>
